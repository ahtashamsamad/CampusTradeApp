rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // User profile images folder
    match /users/{userId}/{allPaths=**} {
      allow read: if true; // Profile pictures are public
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Listing images folder
    match /listings/{allPaths=**} {
      allow read: if true; // Listings are public
      allow write: if request.auth != null; // Any authenticated user can upload for a listing
      // In a real app, you'd check if they own the listing, but this is better than before
    }

    // Default deny for everything else
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}

