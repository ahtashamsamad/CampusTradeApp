rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Check if user is admin
    function isAdmin() {
      return request.auth != null && 
             (request.auth.token.admin == true ||
              (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
               get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'));
    }

    // Users collection
    match /users/{userId} {
      // Any authenticated user can read public profile info
      // But only the user themselves or an admin can see sensitive data
      allow read: if request.auth != null;
      
      // Prevent users from changing their own role or other sensitive fields
      allow create: if request.auth != null && request.auth.uid == userId 
                    && (!request.resource.data.keys().hasAny(['role']))
                    && request.resource.data.role == 'user'; // Default to user on creation
      
      allow update: if request.auth != null && (request.auth.uid == userId || isAdmin())
                    && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'email']));
      
      // Only admins can change roles
      allow write: if isAdmin();

      // Notifications subcollection
      match /notifications/{notificationId} {
        allow read, write: if request.auth.uid == userId || isAdmin();
      }
    }

    // Listings collection
    match /listings/{listingId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth.uid == resource.data.sellerId || isAdmin();
    }

    // Reports collection
    match /reports/{reportId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
      allow create: if request.auth != null;
    }

    // Chats collection
    match /chats/{chatId} {
      // Allow users involved in the chat to read/write
      // Assuming chatId is composed of userIds or there's a participants array
      allow read, write: if request.auth != null && 
                         (request.auth.uid in resource.data.participants || isAdmin());
      allow create: if request.auth != null;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

